--!strict
-- A 5x7 bitmap font for the audit renders: printable ASCII, lowercase drawn
-- as small capitals. Characters it does not have draw as a hollow box, so a
-- missing glyph is visible instead of silently dropped.

local Font = {}

Font.WIDTH = 5
Font.HEIGHT = 7
-- Advance per character and per line, in font pixels.
Font.ADVANCE = 6
Font.LINE = 9

