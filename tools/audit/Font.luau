local MISSING = "##### #...# #...# #...# #...# #...# #####"

-- Common non-ASCII characters in game text, drawn as their nearest ASCII.
local SUBSTITUTE: { [number]: string } = {
	[0x00D7] = "X", -- multiplication sign, used for close buttons
	[0x2715] = "X",
	[0x2716] = "X",
	[0x2013] = "-",
	[0x2014] = "-",
	[0x2022] = "*",
	[0x00B7] = ".",
	[0x2019] = "'",
	[0x2018] = "'",
	[0x201C] = '"',
	[0x201D] = '"',
	[0x2026] = "...",
	[0x2192] = ">",
	[0x2190] = "<",
	[0x2605] = "*",
	[0x00A0] = " ",
}

-- Each glyph as 7 rows of 5 booleans.
local glyphs: { [string]: { { boolean } } } = {}

local function parse(spec: string): { { boolean } }
	local rows = {}
	for _, row in string.split(spec, " ") do
		local bits = {}
		for i = 1, 5 do
			bits[i] = string.sub(row, i, i) == "#"
		end
		table.insert(rows, bits)
	end
	assert(#rows == 7, "a glyph has 7 rows")
	return rows
end

for ch, spec in SOURCE do
	glyphs[ch] = parse(spec)
end
local missing = parse(MISSING)

export type Glyph = { glyph: { { boolean } }, small: boolean }

-- The glyphs for a UTF-8 string, one per character as the font draws it.
function Font.layout(text: string): { Glyph }
	local out: { Glyph } = {}
	local ok = pcall(function()
		for _, code in utf8.codes(text) do
			local ch: string
			if code < 128 then
				ch = string.char(code)
			else
				ch = SUBSTITUTE[code] or ""
			end
			if ch == "" then
				table.insert(out, { glyph = missing, small = false })
			else
				for i = 1, #ch do
					local c = string.sub(ch, i, i)
					local upper = string.upper(c)
					local g = glyphs[upper]
					if g == nil then
						table.insert(out, { glyph = missing, small = false })
					else
						table.insert(out, { glyph = g, small = c ~= upper })
					end
				end
			end
		end
	end)
	if not ok then
		-- Not valid UTF-8: show one missing box per byte.
		out = {}
		for _ = 1, #text do
			table.insert(out, { glyph = missing, small = false })
		end
	end
	return out
end

-- Width of a line in font pixels.
function Font.width(text: string): number
	local n = #Font.layout(text)
	if n == 0 then
		return 0
	end
	return n * Font.ADVANCE - 1
end

return Font
