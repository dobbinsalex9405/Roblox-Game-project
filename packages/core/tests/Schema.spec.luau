--!strict
local Schema = require("@core/Schema")
local t = require("@testlib")
local describe, it, expect = t.describe, t.it, t.expect

describe("Schema", function()
	it("accepts valid numbers and rejects NaN, infinity and wrong types", function()
		local v = Schema.number({ min = 0, max = 10 })
		expect((v(5, "x"))).toBe(true)
		expect((v(0 / 0, "x"))).toBe(false)
		expect((v(math.huge, "x"))).toBe(false)
		expect((v("5", "x"))).toBe(false)
		expect((v(11, "x"))).toBe(false)
		expect((v(-1, "x"))).toBe(false)
	end)

	it("integer rejects fractions", function()
		local v = Schema.integer()
		expect((v(3, "x"))).toBe(true)
		expect((v(3.5, "x"))).toBe(false)
	end)

	it("string enforces length and pattern", function()
		local v = Schema.string({ maxLength = 3, pattern = "^%a+$" })
		expect((v("abc", "x"))).toBe(true)
		expect((v("abcd", "x"))).toBe(false)
		expect((v("a1", "x"))).toBe(false)
		expect((v(1, "x"))).toBe(false)
	end)

	it("record rejects unknown keys and reports the path", function()
		local v = Schema.record({ a = Schema.integer(), b = Schema.optional(Schema.string()) })
		expect((v({ a = 1 }, "cfg"))).toBe(true)
		local ok, err = v({ a = 1, c = 2 }, "cfg")
		expect(ok).toBe(false)
		expect(err).toContain("unknown key c")
		ok, err = v({ a = "no" }, "cfg")
		expect(ok).toBe(false)
		expect(err).toContain("cfg.a")
	end)

	it("array rejects gaps, non-number keys and oversize lists", function()
		local v = Schema.array(Schema.integer(), { maxLength = 3 })
		expect((v({ 1, 2, 3 }, "x"))).toBe(true)
		expect((v({ 1, 2, 3, 4 }, "x"))).toBe(false)
		expect((v({ [1] = 1, [3] = 3 }, "x"))).toBe(false)
		-- selene: allow(mixed_table)
		expect((v({ 1, foo = 2 }, "x"))).toBe(false)
	end)

	it("map checks keys and values", function()
		local v = Schema.map(Schema.string({ pattern = "^%a+$" }), Schema.integer())
		expect((v({ a = 1, b = 2 }, "x"))).toBe(true)
		expect((v({ a = "1" }, "x"))).toBe(false)
		expect((v({ ["1"] = 1 }, "x"))).toBe(false)
	end)

	it("oneOf and check work", function()
		expect((Schema.oneOf({ "a", "b" })("a", "x"))).toBe(true)
		expect((Schema.oneOf({ "a", "b" })("c", "x"))).toBe(false)
		local even = Schema.check(Schema.integer(), function(n)
			return n % 2 == 0, "must be even"
		end)
		expect((even(2, "x"))).toBe(true)
		local ok, err = even(3, "x")
		expect(ok).toBe(false)
		expect(err).toContain("must be even")
	end)
end)
