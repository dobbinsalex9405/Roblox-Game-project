# Wally output (`cd deps && wally install`). Wally lives in deps/ so its
# Packages/ folder never meets packages/ on case-insensitive disks (Windows,
# macOS), where `wally install` would delete our own code.
/deps/Packages/
/deps/ServerPackages/
/deps/DevPackages/

# Build output
/build/
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
sourcemap.json
globalTypes.d.luau
roblox.yml

# Editors and OS
.DS_Store
.idea/
*.log
.playtest/
/feedback-out/

# Screen-control tool: its Python environment
/tools/screen-control/.venv/
__pycache__/

# Design viewer: npm packages for bundling (tools/designs/viewer)
/tools/designs/viewer/node_modules/
