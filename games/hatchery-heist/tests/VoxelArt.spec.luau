--!strict
-- The voxel art (generated by tools/art/export.py) must cover every species,
-- agree with the config's rarities, and stay within a part budget; the look
-- of each tier (CreatureLooks) must only grow with rarity.
local VoxelArt = require("../src/shared/VoxelArt")
local CreatureLooks = require("../src/shared/CreatureLooks")
local ArtScale = require("../src/shared/ArtScale")
local creatures = require("../config/creatures")
local t = require("@testlib")
local describe, it, expect = t.describe, t.it, t.expect

local RARITIES = { "Common", "Uncommon", "Rare", "Ultra Rare", "Epic", "Legendary", "Godly" }
local ANIMS = { "static", "head", "ears", "tail", "wingL", "wingR", "blink", "glow" }

-- Parts a client builds per creature, at most, by tier. Commons are cheap so
-- a base full of them stays light; Godlies may be lavish because they are
-- one in tens of thousands.
local BUDGET = { 30, 40, 60, 80, 120, 450, 800 }

local function rank(rarity: string): number
	return table.find(RARITIES, rarity) or 0
end

local function boxCount(art: VoxelArt.Art): number
	local n = 0
	for _, part in art.parts do
		n += #part.boxes // 7
	end
	return n
end

describe("Voxel art", function()
	it("draws every species, at the config's rarity", function()
		for id, species in creatures.species do
			local art = VoxelArt.species[id]
			expect(art ~= nil and id or `{id} has no art`).toBe(id)
			if art then
				expect(`{id} {art.rarity}`).toBe(`{id} {species.rarity}`)
			end
		end
		for id in VoxelArt.species do
			expect(creatures.species[id] ~= nil and id or `{id} is not a species`).toBe(id)
		end
	end)

	it("rides every part on the body: each parent chain ends at the body, with no loop", function()
		for id, art in VoxelArt.species do
			local parentOf: { [string]: string? } = {}
			for _, part in art.parts do
				parentOf[part.name] = part.parent
			end
			for _, part in art.parts do
				local at, steps = part.name, 0
				while parentOf[at] ~= nil and steps <= #art.parts do
					at = parentOf[at] :: string
					steps += 1
				end
				local ok = at == "body" and steps <= #art.parts
				expect(if ok then "body" else `{id}.{part.name}: chain ends at {at} after {steps}`).toBe(
					"body"
				)
			end
		end
	end)

	it("is well formed: whole boxes, known colours, parents and animations", function()
		for id, art in VoxelArt.species do
			local names: { [string]: boolean } = {}
			for _, part in art.parts do
				names[part.name] = true
			end
			expect(`{id} has a body: {names.body == true}`).toBe(`{id} has a body: true`)
			for _, part in art.parts do
				expect(#part.boxes % 7).toBe(0)
				expect(#part.boxes).toBeAtLeast(7)
				expect(#part.pivot).toBe(3)
				expect(table.find(ANIMS, part.anim) ~= nil and part.anim or `{id}.{part.name}: {part.anim}`).toBe(
					part.anim
				)
				if part.parent then
					expect(names[part.parent] and part.parent or `{id}.{part.name}: no {part.parent}`).toBe(
						part.parent
					)
				end
				for i = 1, #part.boxes, 7 do
					for k = 3, 5 do
						expect(part.boxes[i + k]).toBeAtLeast(1)
					end
					local colour = part.boxes[i + 6]
					expect(colour).toBeAtLeast(1)
					expect(colour).toBeAtMost(#art.palette)
				end
			end
			for _, hex in art.palette do
				expect(string.match(hex, "^%x%x%x%x%x%x%*?$") ~= nil and hex or `{id}: bad colour {hex}`).toBe(
					hex
				)
			end
		end
	end)

	it("keeps every creature within its tier's part budget", function()
		for id, art in VoxelArt.species do
			local n = boxCount(art)
			local budget = BUDGET[rank(art.rarity)]
			expect(n <= budget and id or `{id} has {n} boxes, budget {budget}`).toBe(id)
		end
	end)

	it("makes creatures more detailed as rarity rises", function()
		-- Per tier, by each creature's longest side: the biggest and the most
		-- detailed of the tier below never clearly beat the smallest and the
		-- plainest of the tier above.
		local tallest, shortest, most, fewest = {}, {}, {}, {}
		for _, art in VoxelArt.species do
			local r = rank(art.rarity)
			local h, n = math.max(art.size[1], art.size[2], art.size[3]), boxCount(art)
			tallest[r] = math.max(tallest[r] or 0, h)
			shortest[r] = math.min(shortest[r] or math.huge, h)
			most[r] = math.max(most[r] or 0, n)
			fewest[r] = math.min(fewest[r] or math.huge, n)
		end
		-- How big a creature stands in the game comes from Layout.raritySize
		-- (art is drawn exactly as tall as its stand-in), so only detail is
		-- checked here, not the art's own height.
		for r = 2, #RARITIES do
			expect(fewest[r]).toBeAtLeast(math.floor(most[r - 1] * 0.6))
		end
	end)

	it("only glows from Ultra Rare up", function()
		for id, art in VoxelArt.species do
			local glows = false
			for _, hex in art.palette do
				if string.sub(hex, -1) == "*" then
					glows = true
				end
			end
			if rank(art.rarity) < 4 then
				expect(`{id} glows: {glows}`).toBe(`{id} glows: false`)
			end
		end
	end)
end)

describe("Creature looks by tier", function()
	it("has a look for every tier that only ever adds", function()
		local prev: CreatureLooks.Look? = nil
		for _, rarity in RARITIES do
			local look = CreatureLooks[rarity]
			expect(look ~= nil and rarity or `{rarity} has no look`).toBe(rarity)
			if prev then
				expect(look.light).toBeAtLeast(prev.light)
				expect(look.particles).toBeAtLeast(prev.particles)
				expect(look.hover).toBeAtLeast(prev.hover)
				expect(look.orbit).toBeAtLeast(prev.orbit)
				-- The hatch reveal builds up more for rarer creatures.
				expect(look.wobble).toBeAtLeast(prev.wobble)
				expect(look.rays).toBeAtLeast(prev.rays)
				expect(look.confetti).toBeAtLeast(prev.confetti)
				expect(look.shake).toBeAtLeast(prev.shake)
				expect(look.hold).toBeAtLeast(prev.hold)
				for name, on in prev.moves :: { [string]: boolean } do
					if on then
						expect(`{rarity} {name}: {(look.moves :: any)[name]}`).toBe(`{rarity} {name}: true`)
					end
				end
				if prev.ring then
					expect(look.ring).toBe(true)
				end
			end
			prev = look
		end
		expect(CreatureLooks.Godly.shimmer).toBe(true)
		expect(CreatureLooks.Common.light).toBe(0)
		-- A Common's reveal is quick so a player hatching dozens isn't held up;
		-- even a Godly's stays short enough to sit through.
		expect(CreatureLooks.Common.wobble + CreatureLooks.Common.hold).toBeAtMost(4)
		expect(CreatureLooks.Godly.wobble + CreatureLooks.Godly.hold).toBeAtMost(10)
	end)

	-- Studio playtest: four or five Legendaries and Godlies on one base washed
	-- it out in bloom. The biggest tiers glow less brightly per voxel (they
	-- have the most glowing voxels), and their lights stay modest.
	it("keeps the big tiers' glow from washing out a base", function()
		local prev: CreatureLooks.Look? = nil
		for _, rarity in RARITIES do
			local look = CreatureLooks[rarity]
			expect(look.neon > 0 and look.neon <= 1).toBe(true)
			if prev then
				expect(look.neon).toBeAtMost(prev.neon)
			end
			prev = look
		end
		expect(CreatureLooks.Legendary.neon).toBeAtMost(0.7)
		expect(CreatureLooks.Godly.neon).toBeAtMost(0.6)
		expect(CreatureLooks.Godly.light).toBeAtMost(16)
	end)

	-- Studio playtest: a ridden Phoenix stood 6.5 studs (its crest above its
	-- body), over the 6-stud mount limit. Every creature's whole art, crest
	-- and all, now stands exactly as tall as the server's stand-in, so the
	-- pad, mount and carry sizes in Layout are the only size knobs.
	it("draws every creature's whole art exactly as tall as its stand-in", function()
		for speciesId, art in VoxelArt.species do
			local artHeight = art.size[2] * VoxelArt.voxel
			for _, standIn in { 2, 3.8, 4.8, 6 } do
				local drawn = artHeight * ArtScale.drawScale(standIn, artHeight)
				expect(math.abs(drawn - standIn) < 1e-6 and "fits" or `{speciesId}: {drawn} for {standIn}`).toBe(
					"fits"
				)
			end
		end
	end)

	-- Godly thread, Nov 5: at 6 studs tall the Clockwork Leviathan is about 15
	-- studs long, past its 10-deep spot. A long creature is scaled down
	-- evenly until its length fits, keeping its proportions.
	it("scales a long creature down to fit its spot, keeping its shape", function()
		local height, length = 2, 5 -- native studs: 2.5 times as long as tall
		local k = ArtScale.drawScale(6, height, length, 9.5)
		expect(math.abs(length * k - 9.5) < 1e-9).toBe(true)
		expect(math.abs((length * k) / (height * k) - 2.5) < 1e-9).toBe(true)
		-- A short creature is untouched: as tall as its stand-in.
		expect(ArtScale.drawScale(6, 2, 3, 9.5)).toBe(3)
		-- Every creature drawn today fits its pad, even at Godly size (3.8).
		for speciesId, art in VoxelArt.species do
			local standIn = 3.8
			local artHeight = art.size[2] * VoxelArt.voxel
			local artLength = math.max(art.size[1], art.size[3]) * VoxelArt.voxel
			local drawn = artLength * ArtScale.drawScale(standIn, artHeight, artLength, 9.5)
			expect(drawn <= 9.5 + 1e-9 and "fits" or `{speciesId} is {drawn} long`).toBe("fits")
		end
	end)

	-- Studio gate, Nov 5: the Butterfly's head rode on its left wing and the
	-- wing on its head, and it drew as one dark cube. Every part's chain of
	-- parents must end at the body.
	it("never lets two parts ride on each other", function()
		for speciesId, art in VoxelArt.species do
			local parentOf: { [string]: string? } = {}
			for _, part in art.parts do
				parentOf[part.name] = part.parent
			end
			for _, part in art.parts do
				local name: string? = part.name
				local steps = 0
				while name and parentOf[name] do
					name = parentOf[name]
					steps += 1
					if steps > #art.parts then
						break
					end
				end
				expect(if steps <= #art.parts then "ok" else `{speciesId}.{part.name} loops`).toBe("ok")
			end
		end
	end)
end)
