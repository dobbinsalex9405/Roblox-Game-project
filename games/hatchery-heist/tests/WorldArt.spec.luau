--!strict
-- The world props (generated by tools/art/world/export.py) must be well
-- formed and light enough to build from Parts: whole boxes, known colours,
-- parents that exist, and a box budget per kind.
local WorldArt = require("../src/shared/WorldArt")
local t = require("@testlib")
local describe, it, expect = t.describe, t.it, t.expect

-- Most boxes a prop of each kind may have. Trees and the Golden Nest are
-- big and few; decor is many and small.
local BUDGET: { [string]: number } = {
	tree = 160,
	bush = 80,
	stump = 40,
	egg = 90,
	pedestal = 60,
	belt = 60,
	hub = 160,
	elevator = 200,
	ladder = 20,
	plaque = 20,
	decor = 80,
	tower = 260,
	room = 120,
	building = 700, -- the farm hub's buildings: few, big, one of each (the barn is the landmark)
	hubprop = 80,
}
local ANIMS =
	{ "static", "slide", "spin", "sway", "bob", "flicker", "pulse", "roll", "rock", "turn", "drip", "glint" }

local function boxCount(prop: WorldArt.Prop): number
	local n = 0
	for _, part in prop.parts do
		n += #part.boxes // 7
	end
	return n
end

describe("World art", function()
	it("has the props the game places", function()
		for _, id in
			{
				"OakTree",
				"PineTree",
				"AppleTree",
				"BlossomTree",
				"Bush",
				"Stump",
				"EggPedestal",
				"BeltSlat",
				"BeltRail",
			}
		do
			expect(WorldArt.props[id] ~= nil and id or `{id} is missing`).toBe(id)
		end
	end)

	it("is well formed: whole boxes, known colours, parents and animations", function()
		for id, prop in WorldArt.props do
			expect(prop.voxel > 0 and id or `{id} voxel {prop.voxel}`).toBe(id)
			expect(#prop.size).toBe(3)
			local names: { [string]: boolean } = {}
			for _, part in prop.parts do
				names[part.name] = true
			end
			for _, part in prop.parts do
				expect(#part.boxes % 7).toBe(0)
				expect(#part.boxes).toBeAtLeast(7)
				expect(#part.pivot).toBe(3)
				expect(table.find(ANIMS, part.anim) ~= nil and part.anim or `{id}.{part.name}: {part.anim}`).toBe(
					part.anim
				)
				if part.parent then
					expect(names[part.parent] == true and part.parent or `{id}.{part.name}: no {part.parent}`).toBe(
						part.parent
					)
				end
				for i = 1, #part.boxes, 7 do
					local c = part.boxes[i + 6]
					expect(c >= 1 and c <= #prop.palette and c == math.floor(c)).toBe(true)
					for k = 3, 5 do
						expect(part.boxes[i + k] >= 1).toBe(true)
					end
				end
			end
			for _, hex in prop.palette do
				expect(string.match(hex, "^%x%x%x%x%x%x%*?$") ~= nil and hex or `{id}: bad colour {hex}`).toBe(
					hex
				)
			end
		end
	end)

	it("stays within each kind's box budget", function()
		for id, prop in WorldArt.props do
			local budget = BUDGET[prop.kind]
			expect(budget ~= nil and prop.kind or `{id}: unknown kind {prop.kind}`).toBe(prop.kind)
			if budget then
				local n = boxCount(prop)
				expect(n <= budget and id or `{id}: {n} boxes > {budget}`).toBe(id)
			end
		end
	end)

	it("puts decor on a real floor and zone", function()
		for id, prop in WorldArt.props do
			if prop.kind == "decor" then
				local okFloor = prop.floor == nil or (prop.floor >= 1 and prop.floor <= 10)
				expect(okFloor and id or `{id}: floor {prop.floor}`).toBe(id)
				expect(prop.zone ~= nil and id or `{id}: no zone`).toBe(id)
			end
		end
	end)

	it("has a whole apartment shell for every floor, all on one anchor", function()
		for floor = 1, 10 do
			for _, piece in { "Floor", "Back", "Left", "Right", "Front" } do
				local id = `Tower{piece}{floor}`
				local prop = WorldArt.props[id]
				expect(prop ~= nil and id or `{id} is missing`).toBe(id)
				if prop then
					expect(prop.kind).toBe("tower")
					expect(prop.floor).toBe(floor)
					expect(prop.anchor ~= nil and id or `{id}: no anchor`).toBe(id)
				end
			end
		end
		local roof = WorldArt.props.TowerRoof
		expect(roof ~= nil and roof.anchor ~= nil).toBe(true)
	end)

	it("keeps the ladder's way up clear in every storey", function()
		-- Base-local studs: the deck opening beside the ladder on floors 2-10
		-- (Geometry.LADDER_HOLE_MIN/MAX) and the strip the ladder climbs.
		local function blocks(
			id: string,
			x0: number,
			x1: number,
			z0: number,
			z1: number,
			y0: number,
			y1: number
		): string?
			local prop = WorldArt.props[id]
			local anchor = prop.anchor :: { number }
			for _, part in prop.parts do
				local b = part.boxes
				for i = 1, #b, 7 do
					local bx0, by0, bz0 =
						(b[i] - anchor[1]) * prop.voxel,
						(b[i + 1] - anchor[2]) * prop.voxel,
						(b[i + 2] - anchor[3]) * prop.voxel
					local bx1, by1, bz1 =
						bx0 + b[i + 3] * prop.voxel, by0 + b[i + 4] * prop.voxel, bz0 + b[i + 5] * prop.voxel
					if bx0 < x1 and bx1 > x0 and bz0 < z1 and bz1 > z0 and by0 < y1 and by1 > y0 then
						return `{id} has a box at x {bx0}..{bx1}, y {by0}..{by1}, z {bz0}..{bz1}`
					end
				end
			end
			return nil
		end
		for floor = 1, 10 do
			for _, piece in { "Floor", "Back", "Left", "Right", "Front" } do
				local id = `Tower{piece}{floor}`
				-- the opening through the slab and the walls above it
				local hole = blocks(id, 21.1, 23.9, 12.6, 16.4, if floor >= 2 then -0.7 else 0.05, 11.4)
				expect(hole or id).toBe(id)
				-- the 2-stud strip outside the right wall the ladder climbs in
				local strip = blocks(id, 24.05, 26.2, 13.5, 15.5, -0.7, 11.4)
				expect(strip or id).toBe(id)
			end
		end
	end)

	it("has decor for every floor's four upgrade zones", function()
		for floor = 1, 10 do
			local zones: { [string]: boolean } = {}
			for _, prop in WorldArt.props do
				if prop.kind == "decor" and prop.floor == floor and prop.zone then
					zones[prop.zone] = true
				end
			end
			for _, zone in { "cozy", "toys", "lighting", "food" } do
				expect(zones[zone] and `{floor} {zone}` or `floor {floor} has no {zone} decor`).toBe(
					`{floor} {zone}`
				)
			end
		end
	end)
end)
