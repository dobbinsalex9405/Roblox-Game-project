--!strict
-- The Blender mesh layout (generated by tools/art/blender/luau.py) must
-- cover every species at the config's rarity, be drawable on the same
-- joints as the voxel boxes, carry a far version of every part, and
-- stay inside the tiers' triangle budgets (build.py splits any mesh over
-- 18,000 triangles; Roblox allows 20,000 a MeshPart).
local CreatureMeshes = require("../src/shared/CreatureMeshes")
local creatures = require("../config/creatures")
local t = require("@testlib")
local describe, it, expect = t.describe, t.it, t.expect

local RARITIES = { "Common", "Uncommon", "Rare", "Ultra Rare", "Epic", "Legendary", "Godly" }
local ANIMS = {
	"body",
	"static",
	"head",
	"ears",
	"tail",
	"wingL",
	"wingR",
	"blink",
	"glow",
	"orbit", -- turns about its pivot on the vertical axis (Godly planets)
	"legFL",
	"legFR",
	"legBL",
	"legBR",
	"legL",
	"legR",
	"leg1L",
	"leg1R",
	"leg2L",
	"leg2R",
	"leg3L",
	"leg3R",
	"leg4L",
	"leg4R",
	"leg5L",
	"leg5R",
	"leg6L",
	"leg6R",
	"finL", -- fins paddle when a fish swims (Walk "swim")
	"finR",
}

-- Triangles a client draws per creature close up (LOD0), at most, by tier;
-- past 30 studs the game draws the LOD1 meshes (4,000 at most). Agreed with
-- the game side for 8 to 10 creatures on a floor on a phone. Godlies may
-- draw up to 100,000: they are 1 in 10,000 to 1 in 50,000 and the showpiece
-- of a floor, and a floor of ten at the Legendary cap (400,000) would still
-- need four Godlies in view to pass it (Alex, Nov 5: far more detail).
local BUDGET = { 15000, 15000, 15000, 20000, 28000, 40000, 100000 }

describe("Creature meshes", function()
	it("cover every species, at the config's rarity", function()
		for id, species in creatures.species do
			local m = CreatureMeshes[id]
			expect(m ~= nil and id or `{id} has no meshes`).toBe(id)
			if m then
				expect(`{id} {m.rarity}`).toBe(`{id} {species.rarity}`)
			end
		end
		for id in CreatureMeshes do
			expect(creatures.species[id] ~= nil and id or `{id} is not a species`).toBe(id)
		end
	end)

	it("rides every part on the body: each parent chain ends at the body, with no loop", function()
		for id, art in CreatureMeshes do
			local parentOf: { [string]: string? } = {}
			for _, part in art.parts do
				parentOf[part.name] = part.parent
			end
			for _, part in art.parts do
				local at, steps = part.name, 0
				while parentOf[at] ~= nil and steps <= #art.parts do
					at = parentOf[at] :: string
					steps += 1
				end
				local ok = at == "body" and steps <= #art.parts
				expect(if ok then "body" else `{id}.{part.name}: chain ends at {at} after {steps}`).toBe(
					"body"
				)
			end
		end
	end)

	it("say how each one walks, and swing every leg from a hip", function()
		local GAITS = { "trot", "waddle", "hop", "scuttle", "slither", "hover", "swim" }
		for id, m in CreatureMeshes do
			expect(table.find(GAITS, m.gait) ~= nil and m.gait or `{id}: gait {m.gait}`).toBe(m.gait)
			for _, part in m.parts do
				if string.sub(part.name, 1, 3) == "leg" then
					expect(`{id}.{part.name} anim {part.anim} parent {part.parent}`).toBe(
						`{id}.{part.name} anim {part.name} parent body`
					)
				end
			end
		end
	end)

	it("are well formed: a body, known animations, parents, unique mesh names", function()
		local seen: { [string]: string } = {}
		for id, m in CreatureMeshes do
			expect(m.assetId).toBeAtLeast(0)
			expect(m.textureId).toBeAtLeast(0)
			-- an uploaded Model always comes with its palette, an Image asset
			-- (tools/art/blender/upload.py; luau.py writes 0 for a Decal id,
			-- which MeshPart.TextureID cannot draw)
			expect(`{id} texture: {m.assetId == 0 or m.textureId > 0}`).toBe(`{id} texture: true`)
			local names: { [string]: boolean } = {}
			for _, part in m.parts do
				names[part.name] = true
			end
			expect(`{id} has a body: {names.body == true}`).toBe(`{id} has a body: true`)
			for _, part in m.parts do
				local label = `{id}.{part.name}`
				expect(table.find(ANIMS, part.anim) ~= nil and part.anim or `{label}: {part.anim}`).toBe(
					part.anim
				)
				if part.parent then
					expect(names[part.parent] and part.parent or `{label}: no {part.parent}`).toBe(
						part.parent
					)
				end
				expect(#part.pivot).toBe(3)
				expect(#part.meshes).toBeAtLeast(1)
				for _, mesh in part.meshes do
					expect(seen[mesh.name] == nil and mesh.name or `{mesh.name} twice`).toBe(mesh.name)
					seen[mesh.name] = id
					expect(#mesh.center).toBe(3)
					expect(#mesh.size).toBe(3)
					if mesh.glow then
						expect(string.match(mesh.glow, "^%x%x%x%x%x%x$") ~= nil).toBe(true)
						-- a closed glow piece, never a flat open sheet: Roblox's
						-- importer drops open one-voxel slabs (paw soles)
						local flat = mesh.size[1] <= 0 or mesh.size[2] <= 0 or mesh.size[3] <= 0
						expect(flat and `{mesh.name} is flat` or "closed").toBe("closed")
					end
				end
			end
		end
	end)

	it("are built at the planned pad sizes, 0.8 to 4.6 studs tall", function()
		-- the game scales them to their boxes (CreatureView.fit); this only
		-- catches a build at the wrong scale
		for id, m in CreatureMeshes do
			local ok = m.height >= 0.8 and m.height <= 4.6
			expect(ok and "planned size" or `{id}: {m.height} studs`).toBe("planned size")
		end
	end)

	it("have a far version (LOD1) of every part, on the same joints, within 4,000 triangles", function()
		local seen: { [string]: boolean } = {}
		for id, m in CreatureMeshes do
			for _, part in m.parts do
				local lod = part.lod1
				expect(lod ~= nil and "lod1" or `{id}.{part.name} has no lod1`).toBe("lod1")
				if lod then
					expect(seen[lod.name] == nil and lod.name or `{lod.name} twice`).toBe(lod.name)
					seen[lod.name] = true
					expect(#lod.center).toBe(3)
					expect(#lod.size).toBe(3)
				end
			end
			expect(m.trisLod1 <= 4000 and "within" or `{id}: lod1 {m.trisLod1} > 4000`).toBe("within")
		end
	end)

	it("stand on legs in left and right pairs (a crab walks on both sides)", function()
		for id, m in CreatureMeshes do
			local left, right = 0, 0
			for _, part in m.parts do
				if string.match(part.name, "^leg") then
					if string.sub(part.name, -1) == "L" then
						left += 1
					else
						right += 1
					end
				end
			end
			expect(left == right and "paired" or `{id}: {left} left legs, {right} right`).toBe("paired")
		end
		local crabLegs = 0
		for _, part in CreatureMeshes.Crab.parts do
			if string.match(part.name, "^leg") then
				crabLegs += 1
			end
		end
		expect(crabLegs >= 6 and "walks" or `Crab: {crabLegs} legs`).toBe("walks")
		-- a bird's flat toes stay part of its foot: two legs, not four
		local gooseLegs = {}
		for _, part in CreatureMeshes.GoldenGoose.parts do
			if string.match(part.name, "^leg") then
				table.insert(gooseLegs, part.name)
			end
		end
		table.sort(gooseLegs)
		expect(table.concat(gooseLegs, " ")).toBe("legL legR")
	end)

	it("mirror each left leg on the right: same size, opposite side (lizards, crabs, seals)", function()
		local function bounds(part: CreatureMeshes.Part): ({ number }, { number })
			local lo, hi = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
			for _, mesh in part.meshes do
				for i = 1, 3 do
					lo[i] = math.min(lo[i], mesh.center[i] - mesh.size[i] / 2)
					hi[i] = math.max(hi[i], mesh.center[i] + mesh.size[i] / 2)
				end
			end
			return lo, hi
		end
		-- A voxel is 0.1 studs (finer for Godlies); allow one, plus bevel.
		local TOLERANCE = 0.13
		for id, m in CreatureMeshes do
			local byName: { [string]: CreatureMeshes.Part } = {}
			for _, part in m.parts do
				byName[part.name] = part
			end
			for name, part in byName do
				if string.match(name, "^leg") and string.sub(name, -1) == "L" and #part.meshes > 0 then
					local other = byName[string.sub(name, 1, -2) .. "R"]
					if other and #other.meshes > 0 then
						local lo, hi = bounds(part)
						local olo, ohi = bounds(other)
						local worst = math.max(
							math.abs(lo[1] + ohi[1]),
							math.abs(hi[1] + olo[1]),
							math.abs(lo[2] - olo[2]),
							math.abs(hi[2] - ohi[2]),
							math.abs(lo[3] - olo[3]),
							math.abs(hi[3] - ohi[3])
						)
						expect(
							worst <= TOLERANCE and "mirrored"
								or `{id} {name}: {math.floor(worst * 100 + 0.5) / 100} studs off its right leg`
						).toBe("mirrored")
					end
				end
			end
		end
	end)

	it("stay within the triangle budgets", function()
		for id, m in CreatureMeshes do
			local budget = BUDGET[table.find(RARITIES, m.rarity) or 1]
			expect(m.tris <= budget and "within" or `{id}: {m.tris} > {budget}`).toBe("within")
		end
	end)
end)
