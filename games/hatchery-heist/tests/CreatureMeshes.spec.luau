--!strict
-- The Blender mesh layout (generated by tools/art/blender/luau.py) must
-- cover every species at the config's rarity, be drawable on the same
-- joints as the voxel boxes, keep each creature the size of its boxes, and
-- stay inside the tiers' triangle budgets (build.py splits any mesh over
-- 18,000 triangles; Roblox allows 20,000 a MeshPart).
local CreatureMeshes = require("../src/shared/CreatureMeshes")
local VoxelArt = require("../src/shared/VoxelArt")
local creatures = require("../config/creatures")
local t = require("@testlib")
local describe, it, expect = t.describe, t.it, t.expect

local RARITIES = { "Common", "Uncommon", "Rare", "Ultra Rare", "Epic", "Legendary", "Godly" }
local ANIMS = { "body", "static", "head", "ears", "tail", "wingL", "wingR", "blink", "glow" }

-- Triangles a client draws per creature, at most, by tier: a base full of
-- Commons stays light; the one-in-thousands showpieces may be lavish.
local BUDGET = { 9000, 14000, 22000, 22000, 35000, 50000, 70000 }

describe("Creature meshes", function()
	it("cover every species, at the config's rarity", function()
		for id, species in creatures.species do
			local m = CreatureMeshes[id]
			expect(m ~= nil and id or `{id} has no meshes`).toBe(id)
			if m then
				expect(`{id} {m.rarity}`).toBe(`{id} {species.rarity}`)
			end
		end
		for id in CreatureMeshes do
			expect(creatures.species[id] ~= nil and id or `{id} is not a species`).toBe(id)
		end
	end)

	it("are well formed: a body, known animations, parents, unique mesh names", function()
		local seen: { [string]: string } = {}
		for id, m in CreatureMeshes do
			expect(m.assetId).toBeAtLeast(0)
			local names: { [string]: boolean } = {}
			for _, part in m.parts do
				names[part.name] = true
			end
			expect(`{id} has a body: {names.body == true}`).toBe(`{id} has a body: true`)
			for _, part in m.parts do
				local label = `{id}.{part.name}`
				expect(table.find(ANIMS, part.anim) ~= nil and part.anim or `{label}: {part.anim}`).toBe(
					part.anim
				)
				if part.parent then
					expect(names[part.parent] and part.parent or `{label}: no {part.parent}`).toBe(
						part.parent
					)
				end
				expect(#part.pivot).toBe(3)
				expect(#part.meshes).toBeAtLeast(1)
				for _, mesh in part.meshes do
					expect(seen[mesh.name] == nil and mesh.name or `{mesh.name} twice`).toBe(mesh.name)
					seen[mesh.name] = id
					expect(#mesh.center).toBe(3)
					expect(#mesh.size).toBe(3)
					if mesh.glow then
						expect(string.match(mesh.glow, "^%x%x%x%x%x%x$") ~= nil).toBe(true)
					end
				end
			end
		end
	end)

	it("are the size of the voxel boxes the game draws instead", function()
		for id, m in CreatureMeshes do
			local art = VoxelArt.species[id]
			if art then
				local boxHeight = art.size[2] * VoxelArt.voxel
				local ratio = m.height / boxHeight
				local ok = ratio >= 0.8 and ratio <= 1.2
				expect(ok and "same size" or `{id}: meshes {m.height}, boxes {boxHeight}`).toBe("same size")
			end
		end
	end)

	it("stay within the triangle budgets", function()
		for id, m in CreatureMeshes do
			local budget = BUDGET[table.find(RARITIES, m.rarity) or 1]
			expect(m.tris <= budget and "within" or `{id}: {m.tris} > {budget}`).toBe("within")
		end
	end)
end)
